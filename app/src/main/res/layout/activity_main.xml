<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="8dp">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:padding="24dp"
        android:text="0"
        android:textColor="@color/text"
        android:textSize="64sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:columnCount="4"
        android:rowCount="5">


        <Button
            android:id="@+id/btn_delete"
            style="@style/CalcButton"
            android:backgroundTint="@color/delete_btn"
            android:text="del" />

        <Button
            android:id="@+id/btn_plus"
            style="@style/CalcButton"
            android:backgroundTint="@color/operation_btn"
            android:text="+" />

        <Button
            android:id="@+id/btn_minus"
            style="@style/CalcButton"
            android:backgroundTint="@color/operation_btn"
            android:text="-" />

        <Button
            android:id="@+id/btn_custom"
            style="@style/CalcButton"
            android:backgroundTint="@color/operation_btn"
            android:text="ID" />

        <Button
            android:id="@+id/btn_7"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="7" />

        <Button
            android:id="@+id/btn_8"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="8" />

        <Button
            android:id="@+id/btn_9"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="9" />

        <Button
            android:id="@+id/btn_times"
            style="@style/CalcButton"
            android:backgroundTint="@color/operation_btn"
            android:text="*" />

        <Button
            android:id="@+id/btn_4"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="4" />

        <Button
            android:id="@+id/btn_5"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="5" />

        <Button
            android:id="@+id/btn_6"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="6" />

        <Button
            android:id="@+id/btn_divide"
            style="@style/CalcButton"
            android:backgroundTint="@color/operation_btn"
            android:text="/" />

        <Button
            android:id="@+id/btn_1"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="1" />

        <Button
            android:id="@+id/btn_2"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="2" />

        <Button
            android:id="@+id/btn_3"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="3" />

        <Button
            android:id="@+id/btn_equals"
            style="@style/CalcButton"
            android:backgroundTint="@color/operation_btn"
            android:text="=" />

        <Button
            android:id="@+id/btn_clear"
            style="@style/CalcButton"
            android:backgroundTint="@color/operation_btn"
            android:text="C" />

        <Button
            android:id="@+id/btn_0"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="0" />

        <Button
            android:id="@+id/btn_dot"
            style="@style/CalcButton"
            android:backgroundTint="@color/normal_btn"
            android:text="." />

        <Button
            android:id="@+id/btn_ian"
            style="@style/CalcButton"
            android:backgroundTint="#86AEB0"
            android:text="Ian" />

    </GridLayout>
</LinearLayout>