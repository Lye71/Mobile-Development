<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="8dp">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:padding="24dp"
        android:text="0"
        android:textColor="@color/text"
        android:textSize="64sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:columnCount="4"
        android:rowCount="5">



        <Button
            android:id="@+id/btn_delete"
            style="@style/CalcButton"
            android:text="del"
            android:backgroundTint="@color/delete_btn" />
        <Button
            android:id="@+id/btn_plus"
            style="@style/CalcButton"
            android:text="+"
            android:backgroundTint="@color/operation_btn" />
        <Button
            android:id="@+id/btn_minus"
            style="@style/CalcButton"
            android:text="-"
            android:backgroundTint="@color/operation_btn" />
        <Button
            android:id="@+id/btn_custom"
            style="@style/CalcButton"
            android:text="ID"
            android:backgroundTint="@color/operation_btn" />
        <Button
            android:id="@+id/btn_7"
            style="@style/CalcButton"
            android:text="7"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_8"
            style="@style/CalcButton"
            android:text="8"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_9"
            style="@style/CalcButton"
            android:text="9"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_times"
            style="@style/CalcButton"
            android:text="*"
            android:backgroundTint="@color/operation_btn" />
        <Button
            android:id="@+id/btn_4"
            style="@style/CalcButton"
            android:text="4"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_5"
            style="@style/CalcButton"
            android:text="5"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_6"
            style="@style/CalcButton"
            android:text="6"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_divide"
            style="@style/CalcButton"
            android:text="/"
            android:backgroundTint="@color/operation_btn" />
        <Button
            android:id="@+id/btn_1"
            style="@style/CalcButton"
            android:text="1"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_2"
            style="@style/CalcButton"
            android:text="2"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_3"
            style="@style/CalcButton"
            android:text="3"
            android:backgroundTint="@color/normal_btn" />
        <Button
            android:id="@+id/btn_equals"
            style="@style/CalcButton"
            android:text="="
            android:backgroundTint="@color/operation_btn" />

    </GridLayout>
</LinearLayout>